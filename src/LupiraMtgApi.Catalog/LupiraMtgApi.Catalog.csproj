<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Bounded context: immutable MTG reference data (cards/auth schema, EF Core),
         Scryfall catalog source, and image storage. No ASP.NET — that lives in the host. -->
    <RootNamespace>LupiraMtgApi.Catalog</RootNamespace>
  </PropertyGroup>

  <!-- The Web SDK provided these as implicit global usings; a plain class library does not,
       so restore the Microsoft.Extensions.* ones the moved code relies on (no ASP.NET). -->
  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.Options" />
    <Using Include="System.Net.Http.Json" />
  </ItemGroup>

  <!-- Catalog hydrates card responses with the latest price; Pricing is a leaf context
       (EF + Npgsql only), so this reference is acyclic. -->
  <ItemGroup>
    <ProjectReference Include="..\LupiraMtgApi.Pricing\LupiraMtgApi.Pricing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.102.3" />

    <!-- DI/config/http abstractions used by AddCatalog (the web SDK supplies these to the
         host transitively; a plain class library must reference them explicitly). -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.9" />
  </ItemGroup>

</Project>
