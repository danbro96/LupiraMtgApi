<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Bounded context: the scan/detection engine (scoring, pipeline, imaging/OCR/set-symbol)
         and the diagnostics ScanLog. Depends on Catalog; the heavy CV deps are isolated here. -->
    <RootNamespace>LupiraMtgApi.Recognition</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LupiraMtgApi.Catalog\LupiraMtgApi.Catalog.csproj" />
  </ItemGroup>

  <!-- Restore the Microsoft.Extensions.* global usings the Web SDK provided implicitly, plus the
       pervasive Recognition domain namespace (scoring/zone/region value objects). No ASP.NET. -->
  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.Options" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="System.Net.Http.Json" />
    <Using Include="LupiraMtgApi.Recognition.Domain" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Marten" Version="9.8.2" />
    <PackageReference Include="CoenM.ImageSharp.ImageHash" Version="1.3.6" />
    <!-- Pinned to 3.1.12 (last version under the free Six Labors Split License). 4.x enforces a
         paid commercial license at build time — bump only with a purchased license key. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <PackageReference Include="Svg.Skia" Version="5.1.1" />

    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.9" />
  </ItemGroup>

</Project>
