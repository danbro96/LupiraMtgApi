{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=postgres;Port=5432;Database=lupira_mtg;Username=lupira_mtg_user;Password=REPLACE_ME"
  },
  "Auth": {
    "LastSeenWriteInterval": "00:15:00",
    "AllowedOrigins": []
  },
  "Florence": {
    "Url": "http://florence-api:8080",
    "ApiKey": "REPLACE_ME"
  },
  "Minio": {
    "Endpoint": "minio:9000",
    "PublicEndpoint": "https://s3.lupira.com",
    "AccessKey": "REPLACE_ME",
    "SecretKey": "REPLACE_ME",
    "Bucket": "lupira-mtg-cards",
    "UseSsl": false
  },
  "Scan": {
    "Scoring": {
      "PHashWeight": 0.45,
      "OcrWeight": 0.55,
      "NameWeight": 0.40,
      "TypeLineWeight": 0.10,
      "RulesTextWeight": 0.20,
      "PowerToughnessWeight": 0.10,
      "BottomMetadataWeight": 0.20,
      "NameCutoff": 0.30,
      "TypeLineCutoff": 0.40,
      "RulesTextCutoff": 0.30,
      "NameTopK": 25,
      "TypeLineTopK": 50,
      "RulesTextTopK": 50,
      "HighCombined": 0.85,
      "MediumCombined": 0.60,
      "HighZoneAgreementMinScore": 0.70,
      "HighZoneAgreementMinCount": 2,
      "FullCardPHashMaxHamming": 16
    }
  },
  "ScryfallSync": {
    "CronSchedule": "0 4 * * *"
  },
  "RateLimit": {
    "RequestsPerMinute": 120
  },
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:8080" }
    }
  }
